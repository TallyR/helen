---
interface Props {
  title: string;
  icon: string;
  crumb: string;
}
const { title, icon, crumb } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const pages = [
  { href: '/', label: '☀️ Good morning, Helen' },
  { href: '/chat', label: '💬 Chat' },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>${icon}</text></svg>`} />
  </head>
  <body>
    <aside class="sidebar">
      <div class="workspace"><div class="avatar">H</div>Helen's Space</div>
      <div class="nav-item">🔍 Search</div>
      <div class="nav-item">🏠 Home</div>
      <div class="nav-item">📥 Inbox</div>
      <div class="nav-label">Private</div>
      {pages.map((p) => (
        <a href={p.href} class:list={['nav-item', { active: path === p.href }]}>{p.label}</a>
      ))}
      <div class="nav-item">📓 Journal</div>
      <div class="nav-item">🌷 Things I love</div>
      <div class="nav-item">✈️ Travel plans</div>
    </aside>
    <div class="backdrop" id="backdrop"></div>

    <main>
      <div class="topbar">
        <div class="crumbs">
          <button class="menu" id="menu" aria-label="Open menu">☰</button>
          <span>Private</span>/<span class="current">{crumb}</span>
        </div>
        <div class="topbar-actions">
          <span>Share</span><span>☆</span><span>···</span>
        </div>
      </div>
      <slot />
    </main>

    <script>
      const toggle = () => document.body.classList.toggle('nav-open');
      document.getElementById('menu')?.addEventListener('click', toggle);
      document.getElementById('backdrop')?.addEventListener('click', toggle);
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --sidebar: #f7f7f5;
    --text: #37352f;
    --muted: #787774;
    --faint: #9b9a97;
    --hover: rgba(55, 53, 47, 0.06);
    --border: rgba(55, 53, 47, 0.09);
    --callout: #fbf3db;
    --tag-pink: #f5e0e9;
    --tag-pink-text: #4c2337;
    --tag-yellow: #fbf3db;
    --tag-yellow-text: #402c1b;
    --check: #2383e2;
    --helen: #c2185b;
    --hassan: #1565c0;
    --online: #2ecc71;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #191919;
      --sidebar: #202020;
      --text: rgba(255, 255, 255, 0.81);
      --muted: rgba(255, 255, 255, 0.46);
      --faint: rgba(255, 255, 255, 0.28);
      --hover: rgba(255, 255, 255, 0.055);
      --border: rgba(255, 255, 255, 0.09);
      --callout: #3a3122;
      --tag-pink: #4e2c3c;
      --tag-pink-text: #f0d5e2;
      --tag-yellow: #564328;
      --tag-yellow-text: #f5e5c8;
      --helen: #f48fb1;
      --hassan: #64b5f6;
      color-scheme: dark;
    }
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 16px;
    line-height: 1.5;
    display: flex;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }

  /* Sidebar */
  .sidebar {
    width: 240px;
    flex-shrink: 0;
    background: var(--sidebar);
    padding: 12px 8px;
    font-size: 14px;
    color: var(--muted);
    position: sticky;
    top: 0;
    height: 100vh;
  }
  .workspace {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 8px;
    margin-bottom: 12px;
    color: var(--text);
    font-weight: 500;
  }
  .workspace .avatar {
    width: 22px;
    height: 22px;
    border-radius: 4px;
    background: #e9a0c0;
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 600;
  }
  .nav-label {
    font-size: 12px;
    font-weight: 500;
    padding: 12px 8px 4px;
    color: var(--faint);
  }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 3px 8px;
    border-radius: 6px;
    cursor: default;
    color: inherit;
    text-decoration: none;
  }
  a.nav-item { cursor: pointer; }
  .nav-item:hover { background: var(--hover); }
  .nav-item.active { background: var(--hover); color: var(--text); font-weight: 500; }

  /* Main */
  main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .topbar {
    height: 45px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    font-size: 14px;
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 2;
  }
  .crumbs { display: flex; align-items: center; gap: 4px; color: var(--muted); }
  .crumbs span { padding: 2px 6px; border-radius: 4px; }
  .crumbs .current { color: var(--text); }
  .topbar-actions { display: flex; gap: 4px; color: var(--muted); }
  .topbar-actions span { padding: 2px 8px; border-radius: 4px; }
  .topbar-actions span:hover, .crumbs span:hover { background: var(--hover); }
  .menu {
    display: none;
    font: inherit;
    font-size: 18px;
    line-height: 1;
    color: var(--muted);
    background: none;
    border: 0;
    padding: 4px 8px 4px 0;
    cursor: pointer;
  }
  .backdrop { display: none; }

  @media (max-width: 800px) {
    .sidebar {
      position: fixed;
      left: 0;
      top: 0;
      height: 100dvh;
      z-index: 20;
      transform: translateX(-100%);
      transition: transform 0.2s ease;
      box-shadow: 0 0 24px rgba(0, 0, 0, 0.15);
    }
    body.nav-open .sidebar { transform: none; }
    .backdrop { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.3); z-index: 10; }
    body.nav-open .backdrop { display: block; }
    .menu { display: inline-flex; }
    .topbar-actions { display: none; }
  }
</style>
